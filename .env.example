# AuraSign - Environment Configuration Template
# Copy this file to .env and fill in your PayPal Sandbox credentials.

# PayPal Sandbox API Credentials
# Obtain these from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Feature Flag: Set to 'true' to enable PayPal Sandbox Checkout, or 'false' to disable completely
ENABLE_PAYPAL=true
